{
  "expo": {
    "name": "APEX-CS",
    "slug": "apex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/apex-icon1.png",
    "scheme": "apex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/apex-icon1.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.apex",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/apex-icon1.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/apex-icon1.png",
          "color": "#386BF6"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow APEX-CS to access your camera to scan classroom group examination QR codes."
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60fcfef1-f7ba-430e-9807-edbefbb1bf4b"
      }
    }
  }
}
