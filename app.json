{
  "expo": {
    "name": "APEX-CS",
    "slug": "apex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/apex-icon2.png",
    "scheme": "apex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/apex-icon2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.apex",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/apex-icon2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/apex-icon2.png",
          "color": "#386BF6"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
